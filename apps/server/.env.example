# EC2에 docker-compose로 배포할 때 실제 값을 채운 .env 파일을 만들어서 사용한다.
# 이 파일 자체는 예시일 뿐이며 실제 비밀값은 절대 커밋하지 않는다.

DOCKERHUB_USERNAME=your-dockerhub-username
IMAGE_TAG=latest

DB_ROOT_PASSWORD=change-me

# 최초 배포 등 스키마가 아직 없는 상태에서 한 번 부트스트랩할 때만 update로 설정하고,
# 테이블 생성 확인 후에는 반드시 지우거나 validate로 되돌릴 것.
# JPA_DDL_AUTO=update

JWT_SECRET=change-me-must-be-at-least-256-bits-long-for-hs256-signing-algorithm

KAKAO_CLIENT_ID=change-me
KAKAO_CLIENT_SECRET=change-me
KAKAO_REDIRECT_URI=https://your-domain.example.com/oauth/kakao/callback

# 관리자 권한은 더 이상 환경변수가 아니라 users.role(USER/ADMIN) 컬럼으로 관리한다.
# 새 운영진에게 권한을 줄 때는 DB에서 다음을 실행:
#   UPDATE users SET role = 'ADMIN' WHERE id = <해당 유저 id>;
